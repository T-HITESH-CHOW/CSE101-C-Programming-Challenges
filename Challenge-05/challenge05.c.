
#include <stdio.h>
#include <math.h>

int main()
{
    int ch, n, i;
    long long fact;
    double a, b, c, d, x1, x2;

    do
    {
        printf("\n1. Linear Equation\n");
        printf("2. Factorial\n");
        printf("3. Quadratic Equation\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                printf("Enter a and b: ");
                scanf("%lf%lf", &a, &b);

                if (a != 0)
                    printf("x = %.2f\n", -b / a);
                else if (b == 0)
                    printf("Infinite solutions\n");
                else
                    printf("No solution\n");
                break;

            case 2:
                printf("Enter n (0 to 12): ");
                scanf("%d", &n);

                if (n < 0 || n > 12)
                    printf("Invalid number\n");
                else
                {
                    fact = 1;
                    for (i = 1; i <= n; i++)
                        fact = fact * i;

                    printf("Factorial = %lld\n", fact);
                }
                break;

            case 3:
                printf("Enter a, b and c: ");
                scanf("%lf%lf%lf", &a, &b, &c);

                if (a == 0)
                    printf("Not a quadratic equation\n");
                else
                {
                    d = b * b - 4 * a * c;

                    if (d > 0)
                    {
                        x1 = (-b + sqrt(d)) / (2 * a);
                        x2 = (-b - sqrt(d)) / (2 * a);
                        printf("Roots = %.2f and %.2f\n", x1, x2);
                    }
                    else if (d == 0)
                    {
                        x1 = -b / (2 * a);
                        printf("Equal roots = %.2f\n", x1);
                    }
                    else
                        printf("No real roots\n");
                }
                break;

            case 4:
                printf("Program ended.\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    } while (ch != 4);

    return 0;
}
